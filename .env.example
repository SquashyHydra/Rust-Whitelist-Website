DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rust_whitelist"
APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
ADMIN_ALLOWLIST="admin1@example.com,admin2@example.com"
ADMIN_NOTIFICATION_EMAILS="admin1@example.com,admin2@example.com"
STEAM_API_KEY="your-steam-web-api-key"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="smtp-user"
SMTP_PASS="smtp-password"
SMTP_FROM="Rust Whitelist <noreply@example.com>"
RCON_HOST="127.0.0.1"
RCON_PORT="28016"
RCON_PASSWORD="replace-me"
RCON_TIMEOUT_MS="10000"
RCON_WHITELIST_COMMAND_TEMPLATE="oxide.grant user {steamId} whitelist.allow"
AUTH_SECRET="replace-with-a-long-random-secret"
